  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0"
  }
}